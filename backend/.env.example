NODE_ENV=development
PORT=4000
INSTANCE_ID=api-1

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/datn2627

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
JWT_ACCESS_SECRET=change_this_to_a_random_32_char_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change_this_to_a_random_32_char_string
JWT_REFRESH_TTL_DAYS=7

# --- CORS (phan cach bang dau phay) ---
CORS_ORIGINS=http://app.localhost:3000,http://localhost:3000

# --- LiveKit ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change_this_to_your_livekit_secret
LIVEKIT_TOKEN_TTL_HOURS=6

# --- Object storage (MinIO khi dev, R2 khi prod) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=datn2627
STORAGE_REGION=us-east-1

# --- AI ---
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
AI_TIMEOUT_MS=30000

# --- Whiteboard ---
WB_PERSIST_DEBOUNCE_MS=15000
WB_PERSIST_MAX_INTERVAL_MS=60000
WB_OPS_BUFFER_SIZE=500

# --- Meeting ---
MEETING_AUTO_END_AFTER_MIN=10
