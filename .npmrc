# @nestjs/common nạp class-validator/class-transformer bằng require() từ context
# của chính nó. Chúng là optional peer nên pnpm không link vào .pnpm store.
# public-hoist đưa chúng lên node_modules gốc — là thư mục cha của .pnpm,
# nên require() từ trong store resolve được.
public-hoist-pattern[]=*class-validator*
public-hoist-pattern[]=*class-transformer*